# ──────────────────────────────────────────────────────────────────────────────
# Nebula — Environment Configuration Template (Section 24.11 & 24.12)
#
# Copy this file to .env.local for local development.
# NEVER commit real secrets to source control.
# Production secrets are injected via CI/CD environment variables or a
# secrets manager (e.g. AWS Secrets Manager, HashiCorp Vault).
# ──────────────────────────────────────────────────────────────────────────────

# App
VITE_APP_NAME=Nebula
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=development          # development | staging | production

# API
VITE_API_BASE_URL=http://localhost:3000
VITE_API_TIMEOUT_MS=30000

# Feature flags (Section 24.14)
VITE_FF_PREMIUM_THEMES=true
VITE_FF_FACE_CLUSTERING=true
VITE_FF_AMBIENT_AUDIO=false

# AI Service
# Browser variables prefixed with VITE_ are public. Keep provider secrets in a
# backend or serverless function and expose only its endpoint to this app.
VITE_AI_ENDPOINT=

# Firebase web configuration (public identifiers; access is protected by
# Firebase Authentication, Firestore Security Rules, and App Check)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Storage / CDN
VITE_CDN_BASE_URL=
VITE_STORAGE_BUCKET=

# Analytics (optional — consent gated, Section 21)
VITE_ANALYTICS_ID=
